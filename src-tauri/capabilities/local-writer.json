{
  "identifier": "local-writer",
  "description": "Bundled local writer controls",
  "windows": ["writer"],
  "permissions": [
    "allow-open-cloud-workspace", "allow-restore-vault", "allow-choose-vault",
    "allow-read-vault", "allow-vault-sequence", "allow-write-vault", "allow-read-vault-attachment", "allow-attach-vault-file",
    "allow-list-local-models", "allow-import-local-model", "allow-remove-local-model",
    "allow-generate-local-reply", "allow-cancel-local-reply"
  ]
}
