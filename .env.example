# Supabase Client Variables
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server Variables
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=your-supabase-jwks-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WebSocket Sync Server
NEXT_PUBLIC_WS_URL=ws://localhost:8080
PORT=8080

# AI Integrations (Sarvam AI API)
SARVAM_API_KEY=your-sarvam-api-key

# Founding waitlist (#85) — Brevo contacts API (double opt-in)
BREVO_API_KEY=
# Shared secret for POST /api/waitlist/retry (cron drain of the Brevo outbox)
WAITLIST_RETRY_SECRET=
# Verified sender for waitlist confirmation emails (Brevo transactional)
WAITLIST_CONFIRM_FROM=
# Public base URL used in confirmation links
NEXT_PUBLIC_APP_URL=

# Billing — Stripe (global / USD). SERVER-ONLY: never expose any of these via NEXT_PUBLIC_*.
# Stripe secret API key (sk_test_… / sk_live_…)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_…) for POST /api/billing/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Price object IDs per tier x cycle x cohort (USD). Cohort: FOUNDING = waitlist spot <= 500, GA = general availability.
# Plus / monthly / founding
STRIPE_PRICE_PLUS_MONTHLY_FOUNDING_USD=
# Plus / monthly / GA
STRIPE_PRICE_PLUS_MONTHLY_GA_USD=
# Plus / annual / founding
STRIPE_PRICE_PLUS_ANNUAL_FOUNDING_USD=
# Plus / annual / GA
STRIPE_PRICE_PLUS_ANNUAL_GA_USD=
# Pro / monthly / founding
STRIPE_PRICE_PRO_MONTHLY_FOUNDING_USD=
# Pro / monthly / GA
STRIPE_PRICE_PRO_MONTHLY_GA_USD=
# Pro / annual / founding
STRIPE_PRICE_PRO_ANNUAL_FOUNDING_USD=
# Pro / annual / GA
STRIPE_PRICE_PRO_ANNUAL_GA_USD=
# Team / monthly / founding (Team is USD-only — no INR rail)
STRIPE_PRICE_TEAM_MONTHLY_FOUNDING_USD=
# Team / monthly / GA
STRIPE_PRICE_TEAM_MONTHLY_GA_USD=
# Team / annual / founding
STRIPE_PRICE_TEAM_ANNUAL_FOUNDING_USD=
# Team / annual / GA
STRIPE_PRICE_TEAM_ANNUAL_GA_USD=

# Billing — Razorpay (India / INR). SERVER-ONLY: hosted checkout only (no checkout.js, no NEXT_PUBLIC key).
# Razorpay key id (rzp_test_… / rzp_live_…)
RAZORPAY_KEY_ID=
# Razorpay key secret (Basic auth with RAZORPAY_KEY_ID)
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret for POST /api/billing/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Subscription plan IDs per tier x cycle x cohort (INR). Team has no INR plan (USD-only).
# Plus / monthly / founding
RAZORPAY_PLAN_PLUS_MONTHLY_FOUNDING_INR=
# Plus / monthly / GA
RAZORPAY_PLAN_PLUS_MONTHLY_GA_INR=
# Plus / annual / founding
RAZORPAY_PLAN_PLUS_ANNUAL_FOUNDING_INR=
# Plus / annual / GA
RAZORPAY_PLAN_PLUS_ANNUAL_GA_INR=
# Pro / monthly / founding
RAZORPAY_PLAN_PRO_MONTHLY_FOUNDING_INR=
# Pro / monthly / GA
RAZORPAY_PLAN_PRO_MONTHLY_GA_INR=
# Pro / annual / founding
RAZORPAY_PLAN_PRO_ANNUAL_FOUNDING_INR=
# Pro / annual / GA
RAZORPAY_PLAN_PRO_ANNUAL_GA_INR=

# Billing — local/dev toggle: 1 routes checkout through the in-memory fake gateway (no network, no provider).
LEKHAN_FAKE_PAYMENTS=

# Cron authentication — Bearer token required by every /api/cron/* route (retention-prune, billing-reconcile).
CRON_SECRET=
