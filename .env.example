# Optional for the local writing workspace. Use a Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LEKHAN_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=

# Optional cloud editing. The app and relay must share the same ticket secret.
LEKHAN_SYNC_URL=
LEKHAN_SYNC_TICKET_SECRET=

# Server-side key for invitations, ticket issuance, and relay authorization.
SUPABASE_SECRET_KEY=
# The app and relay share the snapshot encryption configuration.
LEKHAN_ENCRYPTION_KEY=
LEKHAN_ENCRYPTION_PREVIOUS_KEYS=

# Relay only. Mount a persistent directory for the write-ahead log.
LEKHAN_WAL_DIR=
LEKHAN_SYNC_MEMORY_LIMIT_MB=
LEKHAN_PRUNE_CHECKPOINTS=
LEKHAN_PRUNE_IMPORT_RECEIPTS=

# Early access and email delivery.
LEKHAN_WAITLIST_RECEIPT_SECRET=
BREVO_API_KEY=
WAITLIST_CONFIRM_FROM=
BREVO_FOUNDING_LIST_ID=
LEKHAN_DRAIN_WAITLIST=

# Optional analytics. Use a PostHog EU project token.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Hosted workspace billing. Use separate provider test keys in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
