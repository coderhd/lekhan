# Supabase Client Variables
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server Variables
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=your-supabase-jwks-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WebSocket Sync Server
NEXT_PUBLIC_WS_URL=ws://localhost:8080
PORT=8080

# AI Integrations (Sarvam AI API)
SARVAM_API_KEY=your-sarvam-api-key

# Founding waitlist (#85) — Brevo contacts API (double opt-in)
BREVO_API_KEY=
# Shared secret for POST /api/waitlist/retry (cron drain of the Brevo outbox)
WAITLIST_RETRY_SECRET=
