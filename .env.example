# Optional for the local writing workspace. Use a Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LEKHAN_PUBLIC_URL=http://localhost:3000
# Optional for a Vercel Preview with no LEKHAN_PUBLIC_URL override.
LEKHAN_USE_VERCEL_PREVIEW_ORIGIN=
NEXT_PUBLIC_DOCS_URL=

# Optional cloud editing. The app and relay must share the same ticket secret.
LEKHAN_SYNC_URL=
LEKHAN_SYNC_TICKET_SECRET=

# Server-side key for invitations, ticket issuance, and relay authorization.
SUPABASE_SECRET_KEY=
# The app and relay share the snapshot encryption configuration.
LEKHAN_ENCRYPTION_KEY=
LEKHAN_ENCRYPTION_PREVIOUS_KEYS=
# Shared documents bucket ceiling in bytes. Defaults to 1 GB.
LEKHAN_DOCUMENTS_STORAGE_LIMIT_BYTES=

# Relay only. Mount a persistent directory for the write-ahead log.
LEKHAN_WAL_DIR=
LEKHAN_SYNC_MEMORY_LIMIT_MB=
LEKHAN_PRUNE_CHECKPOINTS=
LEKHAN_PRUNE_IMPORT_RECEIPTS=

# Early access and email delivery.
LEKHAN_WAITLIST_RECEIPT_SECRET=
BREVO_API_KEY=
WAITLIST_CONFIRM_FROM=
BREVO_FOUNDING_LIST_ID=
LEKHAN_DRAIN_WAITLIST=

# Optional analytics. Use a PostHog EU project token.
NEXT_PUBLIC_GA4_ID=
GA4_MEASUREMENT_API_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=

# Hosted workspace billing. Use separate provider test keys in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_FOUNDING=
STRIPE_PORTAL_CONFIGURATION_GA=
STRIPE_PRICE_PLUS_MONTHLY_FOUNDING_USD=
STRIPE_PRICE_PLUS_MONTHLY_GA_USD=
STRIPE_PRICE_PLUS_ANNUAL_FOUNDING_USD=
STRIPE_PRICE_PLUS_ANNUAL_GA_USD=
STRIPE_PRICE_PRO_MONTHLY_FOUNDING_USD=
STRIPE_PRICE_PRO_MONTHLY_GA_USD=
STRIPE_PRICE_PRO_ANNUAL_FOUNDING_USD=
STRIPE_PRICE_PRO_ANNUAL_GA_USD=
STRIPE_PRICE_TEAM_MONTHLY_FOUNDING_USD=
STRIPE_PRICE_TEAM_MONTHLY_GA_USD=
STRIPE_PRICE_TEAM_ANNUAL_FOUNDING_USD=
STRIPE_PRICE_TEAM_ANNUAL_GA_USD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_MONTHLY_FOUNDING_INR=
RAZORPAY_PLAN_PLUS_MONTHLY_GA_INR=
RAZORPAY_PLAN_PLUS_ANNUAL_FOUNDING_INR=
RAZORPAY_PLAN_PLUS_ANNUAL_GA_INR=
RAZORPAY_PLAN_PRO_MONTHLY_FOUNDING_INR=
RAZORPAY_PLAN_PRO_MONTHLY_GA_INR=
RAZORPAY_PLAN_PRO_ANNUAL_FOUNDING_INR=
RAZORPAY_PLAN_PRO_ANNUAL_GA_INR=

# Authorizes the server-only scheduled billing check.
CRON_SECRET=

# Optional crash reporting. Browser reporting follows the usage analytics preference.
SENTRY_APP_DSN=
NEXT_PUBLIC_SENTRY_APP_DSN=
SENTRY_RELAY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_ERROR_SAMPLE_RATE=
SENTRY_RETENTION_MONITOR_SLUG=

# Relay only. Use the HTTPS ingest origin and token for the Better Stack source.
BETTER_STACK_INGEST_URL=
BETTER_STACK_SOURCE_TOKEN=

# Enable after configuring the Google provider and OAuth redirect URLs in Supabase.
LEKHAN_GOOGLE_OAUTH=
