+
+  it("rolls back checkout when source binding fails", async () => {
+    const f = await fixture({ source: "scheduler" });
+    await db.execute(sql`CREATE FUNCTION reject_test_binding() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'binding test failure'; END $$`);
+    await db.execute(sql`CREATE TRIGGER reject_test_binding BEFORE UPDATE OF context_snapshot ON heartbeat_runs FOR EACH ROW EXECUTE FUNCTION reject_test_binding()`);
+    try {
+      await expect(issueService(db).checkout(f.issueId, f.agentId, ["todo"], f.runId, { bindRunSource: true } as never)).rejects.toThrow("binding test failure");
+      const [issue] = await db.select().from(issues).where(eq(issues.id, f.issueId));
+      const [run] = await db.select().from(heartbeatRuns).where(eq(heartbeatRuns.id, f.runId));
+      expect(issue.status).toBe("todo");
+      expect(issue.checkoutRunId).toBeNull();
+      expect(run.contextSnapshot).toEqual({ source: "scheduler" });
+    } finally {
+      await db.execute(sql`DROP TRIGGER IF EXISTS reject_test_binding ON heartbeat_runs`);
+      await db.execute(sql`DROP FUNCTION IF EXISTS reject_test_binding()`);
+    }
+  });
+
 });
